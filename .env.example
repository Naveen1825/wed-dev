# Firebase Configuration
# Replace these values with your actual Firebase project credentials
# You can find these in your Firebase Console -> Project Settings -> General

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

VITE_CLOUDINARY_UPLOAD_PRESET=preset_name
VITE_CLOUNDNARY_API_CLOUD_NAME=cloud_name
VITE_CLOUNDNARY_API=cloudnary_api
VITE_CLOUNDNARY_API_SECRET=cloudnary_api_secret

# Other App Configuration
VITE_APP_NAME="AniSell"
VITE_ENABLE_MOCK_DATA=true
